{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "source_ids",
    "posts_per_account",
    "max_requests_per_run",
    "run_limit_mill_usd",
    "daily_limit_mill_usd",
    "total_limit_mill_usd",
    "post_mill_usd",
    "user_mill_usd",
    "minimum_interval_seconds",
    "initial_lookback_hours",
    "timeout_seconds",
    "max_response_bytes"
  ],
  "properties": {
    "version": {
      "const": "x-api-pilot-1"
    },
    "source_ids": {
      "const": [
        "x_sentdefender",
        "x_osinttechnical"
      ]
    },
    "posts_per_account": {
      "type": "integer",
      "minimum": 5,
      "maximum": 10
    },
    "max_requests_per_run": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4
    },
    "run_limit_mill_usd": {
      "type": "integer",
      "minimum": 1,
      "maximum": 120
    },
    "daily_limit_mill_usd": {
      "type": "integer",
      "minimum": 1,
      "maximum": 120
    },
    "total_limit_mill_usd": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4500
    },
    "post_mill_usd": {
      "const": 5
    },
    "user_mill_usd": {
      "const": 10
    },
    "minimum_interval_seconds": {
      "type": "integer",
      "minimum": 3600,
      "maximum": 3600
    },
    "initial_lookback_hours": {
      "type": "integer",
      "minimum": 1,
      "maximum": 24
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "max_response_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 500000
    }
  }
}
