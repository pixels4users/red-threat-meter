{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["version", "role", "source", "dependency_group", "license", "bbox", "windows", "max_response_bytes", "max_total_bytes", "max_decoded_bytes", "request_interval_seconds", "collection_interval_seconds", "timeout_seconds", "live_releases"],
  "properties": {
    "version": {"const": "aviation-history-1"}, "role": {"const": "history_quality_only"},
    "source": {"const": "https://adsb.lol/globe_history/"},
    "dependency_group": {"const": "adsb:adsblol"}, "license": {"const": "ODbL-1.0"},
    "bbox": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "integer"}},
    "windows": {"type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": {
      "type": "object", "additionalProperties": false, "required": ["date", "chunk"],
      "properties": {"date": {"type": "string", "format": "date"}, "chunk": {"type": "integer", "minimum": 0, "maximum": 47}}
    }},
    "max_response_bytes": {"type": "integer", "minimum": 1024, "maximum": 32000000},
    "max_total_bytes": {"type": "integer", "minimum": 1024, "maximum": 96000000},
    "max_decoded_bytes": {"type": "integer", "minimum": 1024, "maximum": 160000000},
    "request_interval_seconds": {"type": "number", "minimum": 3, "maximum": 30},
    "collection_interval_seconds": {"type": "integer", "minimum": 300, "maximum": 86400},
    "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 30},
    "live_releases": {"type": "array", "maxItems": 3, "uniqueItems": true, "items": {"type": "string", "pattern": "^av-[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{6}Z-[0-9a-f]{8}$"}}
  }
}
