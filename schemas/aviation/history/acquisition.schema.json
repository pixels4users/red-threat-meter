{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["version", "id", "mode", "started_at", "finished_at", "config", "requests"],
  "properties": {
    "version": {"const": "history-acquisition-1"}, "id": {"type": "string", "pattern": "^ahc-\\d{8}T\\d{6}Z-[0-9a-f]{8}$"},
    "mode": {"enum": ["live", "fixture"]},
    "started_at": {"type": "string", "format": "date-time"}, "finished_at": {"type": "string", "format": "date-time"},
    "config": {"type": "object"},
    "requests": {"type": "array", "minItems": 1, "maxItems": 3, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["window", "requested_at", "received_at", "http_status", "headers", "bytes", "raw_ref", "error"],
      "properties": {
        "window": {"type": "object"}, "requested_at": {"type": "string", "format": "date-time"}, "received_at": {"type": "string", "format": "date-time"},
        "http_status": {"type": ["integer", "null"], "minimum": 100, "maximum": 599},
        "headers": {"type": "object", "additionalProperties": {"type": "string"}},
        "bytes": {"type": "integer", "minimum": 0, "maximum": 32000000},
        "raw_ref": {"type": ["string", "null"], "pattern": "^raw/[0-9a-f]{64}\\.bin$"},
        "error": {"enum": [null, "network_error", "http_error", "response_too_large_or_invalid_length", "truncated_or_oversized_response", "not_requested_after_access_error"]}
      }
    }}
  }
}
