{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "measurement_id", "production_origins", "consent_version", "consent_days", "cookie_days", "source_ids"],
  "properties": {
    "version": {"const": "rta-analytics-v1"},
    "measurement_id": {"type": "string", "pattern": "^G-[A-Z0-9]+$"},
    "production_origins": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["https://redthreatalert.pl", "https://www.redthreatalert.pl"]}},
    "consent_version": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "consent_days": {"const": 180},
    "cookie_days": {"const": 60},
    "source_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9_-]+$"}}
  }
}
