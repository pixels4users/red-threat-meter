{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://osint-dashboard.local/schemas/incident.schema.json",
  "type": "object",
  "properties": {
    "event_key": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{3,119}$"
    },
    "title": {
      "type": "string",
      "minLength": 5,
      "maxLength": 250
    },
    "summary": {
      "type": "string",
      "minLength": 15,
      "maxLength": 2500
    },
    "category": {
      "enum": [
        "military_preparation",
        "sabotage",
        "arms_explosion",
        "airspace_breach",
        "air_activity",
        "cyberattack",
        "border_pressure",
        "gps_jamming",
        "context",
        "cross_border_air_pressure"
      ]
    },
    "status": {
      "enum": [
        "unverified",
        "confirmed_primary",
        "corroborated",
        "disputed",
        "refuted"
      ]
    },
    "occurred_on": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "format": "date"
        }
      ]
    },
    "date_evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "country": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        }
      ]
    },
    "attribution": {
      "type": "object",
      "properties": {
        "actor": {
          "enum": [
            "RU",
            "BY",
            "unknown",
            "other"
          ]
        },
        "status": {
          "enum": [
            "unverified",
            "confirmed_primary",
            "corroborated",
            "disputed",
            "refuted"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 10
        }
      },
      "required": [
        "actor",
        "status",
        "reason"
      ],
      "additionalProperties": false
    },
    "location": {
      "type": "object",
      "properties": {
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "geometry": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "const": "Point"
                },
                "coordinates": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "number",
                      "minimum": -180,
                      "maximum": 180
                    },
                    {
                      "type": "number",
                      "minimum": -90,
                      "maximum": 90
                    }
                  ],
                  "items": false,
                  "minItems": 2,
                  "maxItems": 2
                }
              },
              "required": [
                "type",
                "coordinates"
              ],
              "additionalProperties": false
            }
          ]
        },
        "precision": {
          "enum": [
            "unknown",
            "country",
            "region",
            "city",
            "approximate",
            "exact"
          ]
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "label",
        "geometry",
        "precision",
        "evidence_ids"
      ],
      "additionalProperties": false
    },
    "criteria": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "uniqueItems": true,
        "minItems": 1
      }
    },
    "campaign_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "material_id": {
            "type": "string",
            "minLength": 1
          },
          "claim": {
            "enum": [
              "occurrence",
              "attribution",
              "criterion",
              "timing",
              "location",
              "context"
            ]
          },
          "stance": {
            "enum": [
              "supports",
              "contradicts"
            ]
          },
          "quote": {
            "type": "string",
            "minLength": 8,
            "maxLength": 600
          },
          "origin_id": {
            "type": "string",
            "minLength": 1
          },
          "origin_reason": {
            "type": "string",
            "minLength": 10
          },
          "measurement": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "observation_id",
              "field",
              "value"
            ],
            "properties": {
              "observation_id": {
                "type": "string",
                "pattern": "^ewo_[a-f0-9]{24}$"
              },
              "field": {
                "enum": [
                  "day",
                  "reported_cells",
                  "eligible_cells",
                  "high_cells",
                  "high_cell_share_pct",
                  "bbox",
                  "common_cells",
                  "current_pct",
                  "reference_median_pct",
                  "difference_pp",
                  "reference_days"
                ]
              },
              "value": {
                "oneOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "string",
                    "format": "date"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 4,
                    "maxItems": 4
                  }
                ]
              }
            }
          }
        },
        "required": [
          "id",
          "material_id",
          "claim",
          "stance",
          "origin_id",
          "origin_reason"
        ],
        "additionalProperties": false,
        "oneOf": [
          {
            "required": [
              "quote"
            ],
            "not": {
              "required": [
                "measurement"
              ]
            }
          },
          {
            "required": [
              "measurement"
            ],
            "not": {
              "required": [
                "quote"
              ]
            },
            "properties": {
              "claim": {
                "enum": [
                  "occurrence",
                  "timing",
                  "location",
                  "context"
                ]
              }
            }
          }
        ]
      },
      "minItems": 1
    },
    "incident_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "revision_id": {
      "type": "string",
      "minLength": 1
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "reviewer": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "agent",
            "human"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "type",
        "name"
      ],
      "additionalProperties": false
    },
    "candidate_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "strategic_context": {
      "type": "object",
      "properties": {
        "area_ids": {
          "type": "array",
          "items": {
            "enum": [
              "suwalki_corridor",
              "rzeszow_jasionka",
              "smolensk_gate",
              "brest_region",
              "kaliningrad_oblast",
              "lask_airbase",
              "minsk_mazowiecki_airbase",
              "swinoujscie_lng",
              "baltic_pipe",
              "baltic_subsea_cables"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "reason": {
          "type": "string",
          "minLength": 15,
          "maxLength": 1500
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "area_ids",
        "reason",
        "evidence_ids"
      ],
      "additionalProperties": false
    },
    "assessment_v03": {
      "type": "object",
      "additionalProperties": false,
