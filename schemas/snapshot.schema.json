{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://osint-dashboard.local/schemas/snapshot.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "as_of": {
      "type": "string",
      "format": "date-time"
    },
    "mode": {
      "enum": [
        "live",
        "fixture"
      ]
    },
    "methodology_version": {
      "type": "string",
      "minLength": 1
    },
    "config_hash": {
      "type": "string",
      "minLength": 1
    },
    "code_hash": {
      "type": "string",
      "minLength": 1
    },
    "source_config_hash": {
      "type": "string",
      "minLength": 1
    },
    "window": {
      "type": "object",
      "properties": {
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "end": {
          "type": "string",
          "format": "date-time"
        },
        "timezone": {
          "type": "string",
          "minLength": 1
        },
        "definition": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "start",
        "end",
        "timezone",
        "definition"
      ],
      "additionalProperties": false
    },
    "rtb": {
      "type": "object",
      "properties": {
        "score": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 100
        },
        "raw_reviewed_sum": {
          "type": "integer",
          "minimum": 0
        },
        "capped_reviewed_sum": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "enum": [
            "experimental",
            "incomplete"
          ]
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "contributions": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "minItems": 0
        },
        "exclusions": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "minItems": 0
        },
        "delta_points": {
          "type": [
            "integer",
            "null"
          ]
        },
        "comparison_run_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "components": {
          "type": "object",
          "properties": {
            "hostile_activity": {
              "type": "integer",
              "minimum": 0
            },
            "preparation": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "hostile_activity",
            "preparation"
          ],
          "additionalProperties": false
        },
        "alert": {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "not_assessed",
                "no_threshold_triggered",
                "analyst_review_required"
              ]
            },
            "triggered_rules": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "calibrated": {
              "const": false
            }
          },
          "required": [
            "status",
            "triggered_rules",
            "calibrated"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "score",
        "raw_reviewed_sum",
        "capped_reviewed_sum",
        "status",
        "blockers",
        "contributions",
        "exclusions",
        "delta_points",
        "comparison_run_id"
      ],
      "additionalProperties": false
    },
    "coverage": {
      "type": "object"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "minItems": 0
    },
    "incidents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "event_key": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{3,119}$"
          },
          "title": {
            "type": "string",
            "minLength": 5,
            "maxLength": 250
          },
          "summary": {
            "type": "string",
            "minLength": 15,
            "maxLength": 2500
          },
          "category": {
            "enum": [
              "sabotage",
              "arms_explosion",
              "airspace_breach",
              "air_activity",
              "cyberattack",
              "border_pressure",
              "gps_jamming",
              "context"
            ]
          },
          "status": {
            "enum": [
              "unverified",
              "confirmed_primary",
              "corroborated",
              "disputed",
              "refuted"
            ]
          },
          "occurred_on": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "format": "date"
              }
            ]
          },
          "date_evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "country": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "pattern": "^[A-Z]{2}$"
              }
            ]
          },
          "attribution": {
            "type": "object",
            "properties": {
              "actor": {
                "enum": [
                  "RU",
                  "BY",
                  "unknown",
                  "other"
                ]
              },
              "status": {
                "enum": [
                  "unverified",
                  "confirmed_primary",
                  "corroborated",
                  "disputed",
                  "refuted"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 10
              }
            },
            "required": [
              "actor",
              "status",
              "reason"
            ],
            "additionalProperties": false
          },
          "location": {
            "type": "object",
            "properties": {
              "label": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "geometry": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "const": "Point"
                      },
                      "coordinates": {
                        "type": "array",
                        "prefixItems": [
                          {
                            "type": "number",
                            "minimum": -180,
                            "maximum": 180
                          },
                          {
                            "type": "number",
                            "minimum": -90,
                            "maximum": 90
                          }
                        ],
                        "items": false,
                        "minItems": 2,
                        "maxItems": 2
                      }
                    },
                    "required": [
                      "type",
                      "coordinates"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "precision": {
                "enum": [
                  "unknown",
                  "country",
                  "region",
                  "city",
                  "approximate",
                  "exact"
                ]
              },
              "evidence_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            },
            "required": [
              "label",
              "geometry",
              "precision",
              "evidence_ids"
            ],
            "additionalProperties": false
          },
          "criteria": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true,
              "minItems": 1
            }
          },
          "campaign_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "material_id": {
                  "type": "string",
                  "minLength": 1
                },
                "claim": {
                  "enum": [
                    "occurrence",
                    "attribution",
                    "criterion",
                    "timing",
                    "location",
                    "context"
                  ]
                },
                "stance": {
                  "enum": [
                    "supports",
                    "contradicts"
                  ]
                },
                "quote": {
                  "type": "string",
                  "minLength": 8,
                  "maxLength": 600
                },
                "origin_id": {
                  "type": "string",
                  "minLength": 1
                },
                "origin_reason": {
                  "type": "string",
                  "minLength": 10
                }
              },
              "required": [
                "id",
                "material_id",
                "claim",
                "stance",
                "quote",
                "origin_id",
                "origin_reason"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          },
          "incident_id": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "revision_id": {
            "type": "string",
            "minLength": 1
          },
          "recorded_at": {
            "type": "string",
            "format": "date-time"
          },
          "reviewer": {
            "type": "object",
            "properties": {
              "type": {
                "enum": [
                  "agent",
                  "human"
                ]
              },
              "name": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "type",
              "name"
            ],
            "additionalProperties": false
          },
          "candidate_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          }
        },
        "required": [
          "event_key",
          "title",
          "summary",
          "category",
          "status",
          "occurred_on",
          "date_evidence_ids",
          "country",
          "attribution",
          "location",
          "criteria",
          "campaign_id",
          "evidence",
          "incident_id",
          "revision",
          "revision_id",
          "recorded_at",
          "reviewer",
          "candidate_ids"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "minItems": 0
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "materials": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "as_of",
    "mode",
    "methodology_version",
    "config_hash",
    "code_hash",
    "source_config_hash",
    "window",
    "rtb",
    "coverage",
    "sources",
    "incidents",
    "candidates",
    "limitations",
    "materials"
  ],
  "additionalProperties": false
}
