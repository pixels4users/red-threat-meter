{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Private reviewed context for civilian dashboard commentary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "snapshot_id",
    "mode",
    "analysis_complete",
    "rtb",
    "findings"
  ],
  "properties": {
    "snapshot_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "mode": {
      "enum": [
        "live",
        "fixture"
      ]
    },
    "analysis_complete": {
      "type": "boolean"
    },
    "rtb": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "score",
        "delta_points",
        "methodology_version"
      ],
      "properties": {
        "score": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "delta_points": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -100,
          "maximum": 100
        },
        "methodology_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        }
      }
    },
    "findings": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "role",
          "status",
          "text_pl",
          "evidence_refs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "role": {
            "enum": [
              "situation",
              "action",
              "impact",
              "recommendation"
            ]
          },
          "status": {
            "enum": [
              "accepted",
              "uncertain",
              "rejected"
            ]
          },
          "text_pl": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "evidence_refs": {
            "type": "array",
            "maxItems": 30,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          }
        }
      }
    },
    "selection": {
      "type": "object",
      "properties": {
        "version": {
          "const": "editorial-selection-v1"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "incident_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "decision": {
                "enum": [
                  "lead",
                  "support",
                  "omit"
                ]
              },
              "relevance": {
                "enum": [
                  "direct",
                  "operational_context",
                  "out_of_scope"
                ]
              },
              "timeliness": {
                "enum": [
                  "new",
                  "continuing",
                  "historical",
                  "expired"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 15,
                "maxLength": 1200
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "minItems": 1,
                "maxItems": 30,
                "uniqueItems": true
              }
            },
            "required": [
              "incident_id",
              "decision",
              "relevance",
              "timeliness",
              "reason",
              "evidence_refs"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 200,
          "uniqueItems": true
        },
        "poland_impact": {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "supported",
                "not_established"
              ]
            },
            "finding_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "minItems": 0,
              "maxItems": 3,
              "uniqueItems": true
            },
            "reason": {
              "type": "string",
              "minLength": 15,
              "maxLength": 1200
            }
          },
          "required": [
            "status",
            "finding_ids",
            "reason"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "version",
        "items",
        "poland_impact"
      ],
      "additionalProperties": false
    }
  }
}
