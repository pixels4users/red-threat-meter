# Etapy 0–2 nie wymagają kluczy ani płatnego API.
# Docelowy dostawca AI zostanie dodany po wybraniu i sprawdzeniu integracji.
# Nigdy nie wstawiaj kluczy do konfiguracji źródeł, agentów ani eksportu.

# Dashboard: skopiuj te pola do prywatnego .env.dashboard (chmod 600).
# Klucz serwerowy jest potrzebny wydawcy i lokalnemu API odczytu.
# Nigdy nie używaj prefiksu VITE_ ani nie umieszczaj klucza w web/ lub dist/.
SUPABASE_URL=https://dubhsimiblpfcaudbvjb.supabase.co
SUPABASE_SECRET_KEY=

# API X: osobny prywatny plik .env.x (chmod 600), tylko dla scripts/collect_x.py.
# Token aplikacji do odczytu publicznych wpisów. Nie wklejaj go do czatu.
X_BEARER_TOKEN=

# Newsletter: osobny prywatny .env.newsletter (chmod 600), tylko po stronie serwera.
# Pełny dostęp API jest potrzebny do Contacts, Segments i Broadcasts.
# Nigdy nie dodawaj prefiksu VITE_ ani nie kopiuj tego pliku do frontendu.
RESEND_API_KEY=
